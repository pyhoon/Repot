' Compile-check project for the B4A branch of the optional viewer module.
' It is not an app: it exists so a headless B4A build proves the module
' compiles against the B4A core WebView APIs.
#Region  Project Attributes
	#ApplicationLabel: RepotViewer
	#VersionCode: 1
	#VersionName: 1.6
	#SupportedOrientations: unspecified
	#CanInstallToExternalStorage: False
#End Region

#Region  Activity Attributes 
	#FullScreen: False
	#IncludeTitle: True
#End Region

#Region Project Copyright
#LibraryName: RepotViewer
#LibraryAuthor: Repot contributors
#LibraryVersion: 1.6
#End Region

