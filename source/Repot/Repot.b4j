Sub AppStart (Args() As String)
	Dim u As Double = RepotUnits.ParseLength("12mm", 0)
	Log("Repot " & RepotVersion.LibraryVersion & " loaded; 12mm = " & RepotUnits.FormatNumber(u, 4) & " pt")
End Sub
