AppType=StandardJava
Build1=Default,b4j.example
Group=Default Group
Library1=jcore
Library2=json
Module1=|relative|..\Repot\RepotAggregateDef
Module10=|relative|..\Repot\RepotExpressionRefs
Module11=|relative|..\Repot\RepotFieldDef
Module12=|relative|..\Repot\RepotFontDef
Module13=|relative|..\Repot\RepotGroupDef
Module14=|relative|..\Repot\RepotJsonUtil
Module15=|relative|..\Repot\RepotJsonWriter
Module16=|relative|..\Repot\RepotPageSetup
Module17=|relative|..\Repot\RepotParameterDef
Module18=|relative|..\Repot\RepotSection
Module19=|relative|..\Repot\RepotSortDef
Module2=|relative|..\Repot\RepotDataBinder
Module20=|relative|..\Repot\RepotStyle
Module21=|relative|..\Repot\RepotTemplateLoader
Module22=|relative|..\Repot\RepotUnits
Module23=|relative|..\Repot\RepotValidator
Module24=|relative|..\Repot\RepotVersion
Module3=|relative|..\Repot\RepotDataSet
Module4=|relative|..\Repot\RepotDataSetDef
Module5=|relative|..\Repot\RepotDefinition
Module6=|relative|..\Repot\RepotDiagnostic
Module7=|relative|..\Repot\RepotDiagnostics
Module8=|relative|..\Repot\RepotElement
Module9=RepotEngineTests
NumberOfFiles=0
NumberOfLibraries=2
NumberOfModules=24
Version=10.7
@EndOfDesignText@
'Repot fixture checker and engine unit-test harness.
'
'Validates the templates and data in fixtures/ against the draft schema
'described in docs/template-format.md, then runs the M1 engine tests
'(loading, validation, canonical round-trip and binding). This is
'deliberately NOT a renderer: it keeps the fixtures, schema, loader and
'binder honest before layout exists.
'
'Usage:
'  java -jar RepotTests.jar <fixtures folder> [output folder]
'
'Writes fixture-check.txt next to the jar. CI greps the first line for
'errors=0. See docs/testing.md.

#Region Project Attributes
	#CommandLineArgs:
	#MergeLibraries: True
#End Region

Sub Process_Globals
	Private Errors As List
	Private Warnings As List
	Private Checks As Int

	Private Dir1 As String
	Private FixtureName As String
	Private OutDir As String

	Private CtxDatasets As Map
	Private CtxGroups As Map
	Private CtxParams As Map
	Private CtxFonts As Map
	Private CtxStyles As Map
	Private CtxAggs As Map
	Private CtxGridCols As Int

	Private SectionTypes As String = "|ReportHeader|PageHeader|GroupHeader|Detail|GroupFooter|PageFooter|ReportFooter|"
	Private ElementTypes As String = "|text|field|image|line|rect|"
	Private FunctionNames As String = "|if|len|upper|lower|trim|round|abs|min|max|formatDate|sum|count|avg|"
End Sub

Sub AppStart (Args() As String)
	Dim root As String
	If Args.Length > 0 Then
		root = Args(0)
	Else
		root = FindFixturesFolder
		Log("No fixtures path supplied; using: " & root)
	End If

	Dim names As List
	OutDir = File.DirApp
	If Args.Length > 1 Then OutDir = Args(1)
	Try
		names = File.ListFiles(root)
	Catch
		Dim msg As String = "ERROR fixtures folder not found: " & root
		File.WriteString(OutDir, "fixture-check.txt", "errors=1" & CRLF & msg & CRLF)
		Log(msg)
		Return
	End Try

	names.Sort(True)
	Dim summary As StringBuilder
	summary.Initialize
	Dim tested As Int = 0
	Dim totalErrors As Int = 0
	Dim totalChecks As Int = 0

	For Each n As String In names
		Dim full As String = File.Combine(root, n)
		If File.Exists(full, "template.b4xr") Then
			FixtureName = n
			Dir1 = full
			Reset
			CheckFixture
			tested = tested + 1
			totalErrors = totalErrors + Errors.Size
			totalChecks = totalChecks + Checks

			Dim status As String
			If Errors.Size = 0 Then
				status = "PASS"
			Else
				status = "FAIL"
			End If
			Dim line As String = status & " " & n & " (" & Checks & " checks, " & Errors.Size & " errors, " & Warnings.Size & " warnings)"
			Log(line)
			summary.Append(line).Append(CRLF)
			For Each e As String In Errors
				Log("  error: " & e)
				summary.Append("  error: ").Append(e).Append(CRLF)
			Next
			For Each w As String In Warnings
				summary.Append("  warning: ").Append(w).Append(CRLF)
			Next
		End If
	Next

	Dim engine As RepotEngineTests
	engine.Initialize
	engine.Run(root)
	totalChecks = totalChecks + engine.Checks
	totalErrors = totalErrors + engine.Failures.Size
	Dim engineLine As String
	If engine.Failures.Size = 0 Then
		engineLine = "PASS engine (" & engine.Checks & " checks)"
	Else
		engineLine = "FAIL engine (" & engine.Checks & " checks, " & engine.Failures.Size & " failures)"
	End If
	Log(engineLine)
	summary.Append(engineLine).Append(CRLF)
	For Each f As String In engine.Failures
		Log("  engine: " & f)
		summary.Append("  engine: ").Append(f).Append(CRLF)
	Next

	Dim result As String = "fixtures=" & tested & " checks=" & totalChecks & " errors=" & totalErrors
	File.WriteString(OutDir, "fixture-check.txt", result & CRLF & summary.ToString)
	Log("----")
	Log(result)
	Log("Result written to: " & File.Combine(OutDir, "fixture-check.txt"))
End Sub

Private Sub FindFixturesFolder As String
	Dim candidates() As String = Array As String("..\..\fixtures", "..\fixtures", "fixtures", "..\..\..\fixtures")
	For Each c As String In candidates
		If FolderExists(c) Then Return c
	Next
	Return "fixtures"
End Sub

Private Sub FolderExists (Path As String) As Boolean
	Dim ok As Boolean = False
	Try
		Dim l As List = File.ListFiles(Path)
		ok = True
	Catch
		ok = False
	End Try
	Return ok
End Sub

Private Sub Reset
	Errors.Initialize
	Warnings.Initialize
	Checks = 0
	CtxDatasets.Initialize
	CtxGroups.Initialize
	CtxParams.Initialize
	CtxFonts.Initialize
	CtxStyles.Initialize
	CtxAggs.Initialize
	CtxGridCols = 0
End Sub

Private Sub CheckFixture
	CheckFile("template.b4xr")
	CheckFile("data.json")
	CheckFile("params.json")
	CheckFile("notes.md")

	Dim tpl As Map = LoadMap("template.b4xr")
	If tpl.Size = 0 Then Return

	ValidateTemplate(tpl)
	ValidateData
	ValidateParams
End Sub

Private Sub CheckFile (Name As String)
	Checks = Checks + 1
	If File.Exists(Dir1, Name) = False Then Fail("missing file: " & Name)
End Sub

Private Sub Fail (Msg As String)
	Errors.Add(Msg)
End Sub

Private Sub Warn (Msg As String)
	Warnings.Add(Msg)
End Sub

'--------------------------------------------------------------- helpers

Private Sub Str (o As Object, Key As String) As String
	If o Is Map Then
		Dim m As Map = o
		If m.ContainsKey(Key) Then
			If m.Get(Key) <> Null Then Return m.Get(Key)
		End If
	End If
	Return ""
End Sub

Private Sub MapOf (o As Object, Key As String) As Map
	Dim r As Map
	r.Initialize
	If o Is Map Then
		Dim m As Map = o
		If m.ContainsKey(Key) Then
			If m.Get(Key) Is Map Then r = m.Get(Key)
		End If
	End If
	Return r
End Sub

Private Sub ListOf (o As Object, Key As String) As List
	Dim r As List
	r.Initialize
	If o Is Map Then
		Dim m As Map = o
		If m.ContainsKey(Key) Then
			If m.Get(Key) Is List Then r = m.Get(Key)
		End If
	End If
	Return r
End Sub

Private Sub IsNum (o As Object) As Boolean
	If o = Null Then Return False
	If o Is Boolean Then Return False
	If o Is String Then Return False
	Return IsNumber(o)
End Sub

Private Sub NumberOf (o As Object) As Int
	If IsNum(o) = False Then Return -1
	Dim i As Int = o
	Return i
End Sub

Private Sub LoadMap (Name As String) As Map
	Dim m As Map
	m.Initialize
	Dim txt As String
	Try
		txt = File.ReadString(Dir1, Name)
	Catch
		Fail("cannot read " & Name)
		Return m
	End Try
	If txt.Trim.Length = 0 Then
		Fail("empty file: " & Name)
		Return m
	End If
	Dim o As Object = Null
	Try
		Dim parser As JSONParser
		parser.Initialize(txt)
		o = parser.NextObject
	Catch
		Fail("invalid JSON in " & Name)
		Return m
	End Try
	If o Is Map Then
		m = o
	Else
		Fail(Name & " must contain a JSON object")
	End If
	Return m
End Sub

Private Sub FieldExists (DataSetName As String, FieldName As String) As Boolean
	If CtxDatasets.ContainsKey(DataSetName) = False Then Return False
	Dim info As Map = CtxDatasets.Get(DataSetName)
	Dim fields As List = info.Get("fields")
	Return fields.IndexOf(FieldName) >= 0
End Sub

'--------------------------------------------------------------- template

Private Sub ValidateTemplate (tpl As Map)
	Dim version As String = Str(tpl, "schemaVersion")
	Checks = Checks + 1
	If version <> "0.1" Then Fail("schemaVersion: expected '0.1', found '" & version & "'")

	If Str(tpl, "id").Length = 0 Then Fail("missing report id")
	If Str(tpl, "name").Length = 0 Then Fail("missing report name")

	Dim page As Map = MapOf(tpl, "page")
	If page.Size = 0 Then
		Fail("missing page")
	Else
		ValidatePage(page)
	End If

	Dim fonts As Map = MapOf(tpl, "fonts")
	For Each k As String In fonts.Keys
		CtxFonts.Put(k, True)
	Next

	Dim styles As Map = MapOf(tpl, "styles")
	For Each k As String In styles.Keys
		CtxStyles.Put(k, True)
		Dim st As Map = MapOf(styles, k)
		If st.Size > 0 Then
			Dim fontRef As String = Str(st, "font")
			If fontRef.Length > 0 Then
				If CtxFonts.ContainsKey(fontRef) = False Then
					Fail("style '" & k & "' references unknown font '" & fontRef & "'")
				End If
			End If
		End If
	Next

	Dim params As List = ListOf(tpl, "parameters")
	For Each p0 As Object In params
		If p0 Is Map Then
			Dim pn As String = Str(p0, "name")
			If pn.Length = 0 Then
				Fail("parameter without name")
			Else If CtxParams.ContainsKey(pn) Then
				Fail("duplicate parameter: " & pn)
			Else
				Dim req As Boolean = False
				Dim p As Map = p0
				If p.ContainsKey("required") Then req = p.Get("required")
				CtxParams.Put(pn, req)
			End If
		Else
			Fail("parameter entry is not an object")
		End If
	Next

	Dim dsList As List = ListOf(tpl, "dataSets")
	For Each d0 As Object In dsList
		If d0 Is Map Then
			Dim dn As String = Str(d0, "name")
			If dn.Length = 0 Then
				Fail("dataset without name")
			Else If CtxDatasets.ContainsKey(dn) Then
				Fail("duplicate dataset: " & dn)
			Else
				Dim info As Map
				info.Initialize
				Dim fields As List
				fields.Initialize
				For Each f0 As Object In ListOf(d0, "fields")
					If f0 Is Map Then
						Dim fn As String = Str(f0, "name")
						If fn.Length = 0 Then
							Fail("dataset " & dn & ": field without name")
						Else
							fields.Add(fn)
						End If
					Else
						Fail("dataset " & dn & ": field entry is not an object")
					End If
				Next
				If fields.Size = 0 Then Fail("dataset " & dn & ": no fields")
				info.Put("fields", fields)
				Dim kind As String = Str(d0, "kind")
				If kind = "" Then kind = "rows"
				If kind <> "rows" And kind <> "single" Then Fail("dataset " & dn & ": kind must be rows or single")
				info.Put("kind", kind)
				CtxDatasets.Put(dn, info)
				RegisterAggregates(ListOf(d0, "aggregates"), "dataset " & dn, dn)
			End If
		Else
			Fail("dataset entry is not an object")
		End If
	Next

	Dim groups As List = ListOf(tpl, "groups")
	For Each g0 As Object In groups
		If g0 Is Map Then
			Dim gid As String = Str(g0, "id")
			If gid.Length = 0 Then
				Fail("group without id")
			Else If CtxGroups.ContainsKey(gid) Then
				Fail("duplicate group: " & gid)
			Else
				Dim gds As String = Str(g0, "dataSet")
				If gds.Length = 0 Then
					Fail("group " & gid & ": missing dataSet")
				Else If CtxDatasets.ContainsKey(gds) = False Then
					Fail("group " & gid & ": unknown dataSet " & gds)
				End If
				Dim gi As Map
				gi.Initialize
				gi.Put("dataSet", gds)
				CtxGroups.Put(gid, gi)
				Dim gkey As String = Str(g0, "key")
				If gkey.Length = 0 Then Fail("group " & gid & ": missing key")
				RegisterAggregates(ListOf(g0, "aggregates"), "group " & gid, gds)
			End If
		Else
			Fail("group entry is not an object")
		End If
	Next

	Dim sections As List = ListOf(tpl, "sections")
	If sections.Size = 0 Then Fail("no sections")
	Dim ids As Map
	ids.Initialize
	Dim detailSeen As Int = 0

	For Each s0 As Object In sections
		If (s0 Is Map) = False Then
			Fail("section entry is not an object")
			Continue
		End If
		Dim s As Map = s0
		Dim stype As String = Str(s, "type")
		Dim sid As String = Str(s, "id")

		If stype.Length = 0 Then
			Fail("section without type")
		Else If SectionTypes.IndexOf("|" & stype & "|") < 0 Then
			Fail("unknown section type: " & stype)
		End If

		If sid.Length = 0 Then
			Fail("section " & stype & ": missing id")
		Else If ids.ContainsKey(sid) Then
			Fail("duplicate section id: " & sid)
		Else
			ids.Put(sid, True)
		End If

		Dim secDataset As String = ""
		Select stype
			Case "Detail"
				detailSeen = detailSeen + 1
				secDataset = Str(s, "dataSet")
				If secDataset.Length = 0 Then
					Fail("Detail section: missing dataSet")
				Else If CtxDatasets.ContainsKey(secDataset) = False Then
					Fail("Detail section: unknown dataSet " & secDataset)
				End If
			Case "GroupHeader", "GroupFooter"
				Dim refGroup As String = Str(s, "group")
				If refGroup.Length = 0 Then
					Fail(stype & " section: missing group")
				Else If CtxGroups.ContainsKey(refGroup) = False Then
					Fail(stype & " section: unknown group " & refGroup)
				Else
					Dim gi2 As Map = CtxGroups.Get(refGroup)
					secDataset = gi2.Get("dataSet")
				End If
			Case "PageHeader", "PageFooter"
				If Str(s, "overflow") = "grow" Then
					Fail(stype & " must not use overflow grow")
				End If
		End Select

		Dim h As Object = Null
		If s.ContainsKey("height") Then h = s.Get("height")
		Checks = Checks + 1
		If IsNum(h) = False Then Fail("section " & sid & ": height must be a number")

		ValidateElements(ListOf(s, "elements"), sid, secDataset, ids)
	Next

	If detailSeen = 0 Then Fail("no Detail section")
End Sub

Private Sub ValidatePage (page As Map)
	Dim orient As String = Str(page, "orientation")
	If orient <> "portrait" And orient <> "landscape" Then
		Fail("page.orientation must be portrait or landscape")
	End If

	Dim size As Object = Null
	If page.ContainsKey("size") Then size = page.Get("size")
	If (size Is String) = False And (size Is List) = False Then
		Fail("page.size must be a name or [width, height]")
	End If

	Dim margins As Map = MapOf(page, "margins")
	If margins.Size = 0 Then
		Fail("page.margins missing")
	Else
		Dim keys() As String = Array As String("top", "right", "bottom", "left")
		For Each k As String In keys
			If margins.ContainsKey(k) = False Then Fail("page.margins." & k & " missing")
		Next
	End If

	Dim grid As Map = MapOf(page, "grid")
	If grid.Size > 0 Then
		If grid.ContainsKey("columns") Then CtxGridCols = NumberOf(grid.Get("columns"))
		If grid.ContainsKey("cellHeight") = False And grid.ContainsKey("rows") = False Then
			Fail("page.grid requires cellHeight or rows")
		End If
	End If
End Sub

Private Sub ValidateElements (els As List, SectionId As String, SectionDataset As String, ids As Map)
	If els.Size = 0 Then Warn("section " & SectionId & " has no elements")

	For Each e0 As Object In els
		If (e0 Is Map) = False Then
			Fail(SectionId & ": element is not an object")
			Continue
		End If
		Dim e As Map = e0
		Dim eid As String = Str(e, "id")
		Dim etype As String = Str(e, "type")
		Dim where As String = SectionId & "/" & eid

		If eid.Length = 0 Then
			Fail(SectionId & ": element without id")
			where = SectionId & "/?"
		Else If ids.ContainsKey(eid) Then
			Fail("duplicate element id: " & eid)
		Else
			ids.Put(eid, True)
		End If

		If ElementTypes.IndexOf("|" & etype & "|") < 0 Then
			Fail(where & ": unknown element type '" & etype & "'")
		End If

		Dim hasBounds As Boolean = e.ContainsKey("bounds")
		Dim hasCell As Boolean = e.ContainsKey("cell")
		If hasBounds = hasCell Then
			Fail(where & ": exactly one of bounds or cell is required")
		Else If hasBounds Then
			Dim b As Object = e.Get("bounds")
			If (b Is List) = False Then
				Fail(where & ": bounds must be an array")
			Else
				Dim bl As List = b
				If bl.Size <> 4 Then
					Fail(where & ": bounds must have 4 numbers")
				Else
					Dim bad As Boolean = False
					For Each v As Object In bl
						If IsNum(v) = False Then bad = True
					Next
					If bad Then Fail(where & ": bounds must contain numbers only")
				End If
			End If
		Else
			ValidateCell(MapOf(e, "cell"), where)
		End If

		Dim stl As String = Str(e, "style")
		If stl.Length > 0 Then
			If CtxStyles.ContainsKey(stl) = False Then Fail(where & ": unknown style '" & stl & "'")
		End If

		Dim val As String = Str(e, "value")
		If val.IndexOf("{") >= 0 Or val.IndexOf("}") >= 0 Then
			CheckExpression(val, SectionDataset, where)
		End If

		If etype = "image" Then
			Dim res As String = Str(e, "resource")
			If res.Length = 0 Then
				Fail(where & ": image without resource")
			Else If File.Exists(Dir1, res) = False Then
				Fail(where & ": missing resource file '" & res & "'")
			End If
		End If
	Next
End Sub

Private Sub ValidateCell (cell As Map, Where As String)
	If cell.Size = 0 Then
		Fail(Where & ": cell must be an object")
		Return
	End If
	Dim keys() As String = Array As String("col", "row", "colSpan", "rowSpan")
	For Each k As String In keys
		If IsNum(cell.Get(k)) = False Then Fail(Where & ": cell." & k & " must be a number")
	Next
	Dim col As Int = NumberOf(cell.Get("col"))
	Dim span As Int = NumberOf(cell.Get("colSpan"))
	If CtxGridCols > 0 And col >= 0 And span > 0 Then
		If col + span > CtxGridCols Then
			Fail(Where & ": cell exceeds the " & CtxGridCols & " grid columns")
		End If
	End If
End Sub

Private Sub RegisterAggregates (lst As List, Scope As String, DataSetName As String)
	For Each a0 As Object In lst
		If (a0 Is Map) = False Then
			Fail(Scope & ": aggregate entry is not an object")
			Continue
		End If
		Dim an As String = Str(a0, "name")
		If an.Length = 0 Then
			Fail(Scope & ": aggregate without name")
			Continue
		End If
		If CtxAggs.ContainsKey(an) Then
			Fail("duplicate aggregate name: " & an & " (aggregate names are document-unique)")
			Continue
		End If
		CtxAggs.Put(an, Scope)
		Dim fn As String = Str(a0, "function")
		If fn.Length = 0 Then Fail("aggregate " & an & ": missing function")
		Dim fld As String = Str(a0, "field")
		If fn = "sum" Or fn = "avg" Or fn = "min" Or fn = "max" Then
			If fld.Length = 0 Then
				Fail("aggregate " & an & ": function " & fn & " requires a field")
			Else If DataSetName.Length > 0 Then
				If FieldExists(DataSetName, fld) = False Then
					Fail("aggregate " & an & ": unknown field " & fld & " in " & DataSetName)
				End If
			End If
		End If
	Next
End Sub

'--------------------------------------------------------------- expressions

Private Sub CheckExpression (Expr As String, SectionDataset As String, Where As String)
	Dim depth As Int = 0
	Dim i As Int = 0
	Do While i < Expr.Length
		Dim ch As String = Expr.SubString2(i, i + 1)
		If ch = "{" Then
			depth = depth + 1
		Else If ch = "}" Then
			depth = depth - 1
			If depth < 0 Then
				Fail(Where & ": unbalanced '}' in expression")
				Return
			End If
		End If
		i = i + 1
	Loop
	If depth <> 0 Then
		Fail(Where & ": unbalanced '{' in expression")
		Return
	End If

	Dim seps As String = "(),+-*/=<>!&?:"
	Dim clean As StringBuilder
	clean.Initialize
	Dim inQuote As Boolean = False
	depth = 0
	i = 0
	Do While i < Expr.Length
		Dim c As String = Expr.SubString2(i, i + 1)
		If c = "{" Then
			depth = depth + 1
		Else If c = "}" Then
			depth = depth - 1
		Else If depth > 0 Then
			If inQuote Then
				If c = """" Then inQuote = False
				clean.Append(" ")
			Else If c = """" Then
				inQuote = True
				clean.Append(" ")
			Else If seps.IndexOf(c) >= 0 Then
				clean.Append(" ")
			Else
				clean.Append(c)
			End If
		Else
			clean.Append(" ")
		End If
		i = i + 1
	Loop

	Dim flat As String = clean.ToString
	Dim toks As List
	toks.Initialize
	Dim cur As StringBuilder
	cur.Initialize
	i = 0
	Do While i < flat.Length
		Dim sep As String = flat.SubString2(i, i + 1)
		If sep = " " Then
			If cur.Length > 0 Then
				toks.Add(cur.ToString)
				cur.Initialize
			End If
		Else
			cur.Append(sep)
		End If
		i = i + 1
	Loop
	If cur.Length > 0 Then toks.Add(cur.ToString)

	For Each raw As String In toks
		Dim tok As String = raw
		If tok.Length = 0 Then Continue
		If IsNumber(tok) Then Continue
		If tok = "and" Or tok = "or" Or tok = "not" Or tok = "true" Or tok = "false" Then Continue
		If FunctionNames.IndexOf("|" & tok & "|") >= 0 Then Continue
		If tok = "page.number" Or tok = "page.count" Then Continue

		If tok.Length > 6 Then
			If tok.SubString2(0, 6) = "param." Then
				Checks = Checks + 1
				If CtxParams.ContainsKey(tok.SubString(6)) = False Then
					Fail(Where & ": unknown parameter in expression: " & tok)
				End If
				Continue
			End If
		End If

		Dim dot As Int = tok.IndexOf(".")
		If dot > 0 Then
			Dim dsName As String = tok.SubString2(0, dot)
			Dim rest As String = tok.SubString(dot + 1)
			Checks = Checks + 1
			If CtxDatasets.ContainsKey(dsName) = False Then
				Fail(Where & ": unknown dataset in expression: " & tok)
			Else If FieldExists(dsName, rest) = False And CtxAggs.ContainsKey(rest) = False Then
				Fail(Where & ": unknown field or aggregate in expression: " & tok)
			End If
			Continue
		End If

		If CtxAggs.ContainsKey(tok) Then Continue

		If SectionDataset.Length > 0 Then
			If FieldExists(SectionDataset, tok) Then Continue
		End If

		Fail(Where & ": unknown identifier in expression: " & tok)
	Next
End Sub

'--------------------------------------------------------------- data

Private Sub ValidateData
	Dim data As Map = LoadMap("data.json")
	If data.Size = 0 Then Return

	For Each name As String In CtxDatasets.Keys
		Dim info As Map = CtxDatasets.Get(name)
		Dim kind As String = info.Get("kind")
		Checks = Checks + 1
		If data.ContainsKey(name) = False Then
			Fail("data.json: missing dataset '" & name & "'")
			Continue
		End If
		Dim o As Object = data.Get(name)
		If kind = "single" Then
			If (o Is Map) = False Then
				Fail("data.json: '" & name & "' must be an object for a single dataset")
			Else
				CheckRecord(o, name, info)
			End If
		Else
			If (o Is List) = False Then
				Fail("data.json: '" & name & "' must be an array")
			Else
				Dim lst As List = o
				If lst.Size = 0 Then Fail("data.json: '" & name & "' is empty")
				For Each r0 As Object In lst
					If (r0 Is Map) = False Then
						Fail("data.json: '" & name & "' contains a non-object record")
					Else
						CheckRecord(r0, name, info)
					End If
				Next
			End If
		End If
	Next

	For Each k As String In data.Keys
		Checks = Checks + 1
		If CtxDatasets.ContainsKey(k) = False Then
			Warn("data.json: undeclared dataset '" & k & "'")
		End If
	Next
End Sub

Private Sub CheckRecord (rec As Object, DataSetName As String, Info As Map)
	Dim m As Map = rec
	Dim fields As List = Info.Get("fields")
	For Each f As String In fields
		If m.ContainsKey(f) = False Then
			Fail("data.json/" & DataSetName & ": record is missing field '" & f & "'")
		End If
	Next
	For Each k As String In m.Keys
		If fields.IndexOf(k) < 0 Then
			Warn("data.json/" & DataSetName & ": undeclared field '" & k & "'")
		End If
	Next
End Sub

Private Sub ValidateParams
	Dim p As Map = LoadMap("params.json")
	If p.Size = 0 Then Return

	For Each name As String In CtxParams.Keys
		Dim required As Boolean = CtxParams.Get(name)
		If required Then
			Checks = Checks + 1
			If p.ContainsKey(name) = False Then
				Fail("params.json: missing required parameter '" & name & "'")
			End If
		End If
	Next

	For Each k As String In p.Keys
		If CtxParams.ContainsKey(k) = False Then
			Warn("params.json: undeclared parameter '" & k & "'")
		End If
	Next
End Sub
