' B4A PDF introspection using android.graphics.pdf.PdfRenderer.
' Returns page count and extracts text from a PDF file generated by the
' Printing library vector canvas (PrintVectorPdf).
' Requires API level 16+ (PdfRenderer available since API 16,
' getText available with limitations from API 21+).

Sub Process_Globals
End Sub

'Returns the number of pages in a PDF file.
'Path is the full path to the PDF file (e.g. File.DirInternal & "/output.pdf").
Public Sub GetPdfPageCount (Path As String) As Int
	#If B4A
	#If Java
	Dim jo As JavaObject
	jo.InitializeNewInstance("android.graphics.pdf.PdfRenderer", Array())
	' We need a ParcelFileDescriptor; use RandomAccessFile to get it
	Dim raf As RandomAccessFile
	raf.Initialize(Path, "r")
	Dim pfd As android.os.ParcelFileDescriptor = raf.GetField("mFd")
	If pfd = Null Then
		raf.Close
		Return 0
	End If
	Dim renderer As android.graphics.pdf.PdfRenderer = New android.graphics.pdf.PdfRenderer(pfd)
	Dim count As Int = renderer.PageCount
	renderer.Close
	pfd.Close
	raf.Close
	Return count
	#End If
	#End If
	Return 0
End Sub

'Extracts text from a specific page of a PDF file.
'Path is the full path to the PDF file.
'PageIndex is 0-based page index.
'Returns the extracted text, or empty string if extraction fails.
Public Sub ExtractPdfText (Path As String, PageIndex As Int) As String
	#If B4A
	#If Java
	Dim jo As JavaObject
	jo.InitializeNewInstance("android.graphics.pdf.PdfRenderer", Array())
	Dim raf As RandomAccessFile
	raf.Initialize(Path, "r")
	Dim pfd As android.os.ParcelFileDescriptor = raf.GetField("mFd")
	If pfd = Null Then
		raf.Close
		Return ""
	End If
	Dim renderer As android.graphics.pdf.PdfRenderer = New android.graphics.pdf.PdfRenderer(pfd)
	If PageIndex < 0 Or PageIndex >= renderer.PageCount Then
		renderer.Close
		pfd.Close
		raf.Close
		Return ""
	End If
	Dim page As android.graphics.pdf.PdfRenderer.Page = renderer.GetPage(PageIndex)
	Dim text As String = page.GetText
	page.Close
	renderer.Close
	pfd.Close
	raf.Close
	Return text
	#End If
	#End If
	Return ""
End Sub