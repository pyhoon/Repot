{
  "schemaVersion": "0.1",
  "id": "multilang.scripts",
  "name": "Multi-language listing",
  "description": "Multi-page listing exercising Unicode scripts in text and data.",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": { "top": "12mm", "right": "15mm", "bottom": "18mm", "left": "15mm" },
    "grid": { "columns": 24, "cellHeight": 16 }
  },
  "fonts": {
    "body": { "family": ["DejaVu Sans", "Arial", "sans-serif"], "size": 9 }
  },
  "styles": {
    "title": { "font": "body", "size": 16, "bold": true },
    "label": { "font": "body", "colour": "#555555" },
    "cell": { "font": "body", "valign": "middle", "overflow": "grow" }
  },
  "parameters": [
    { "name": "ReportTitle", "type": "string", "required": true }
  ],
  "dataSets": [
    {
      "name": "Rows",
      "kind": "rows",
      "fields": [
        { "name": "Script", "type": "string" },
        { "name": "Greeting", "type": "string" },
        { "name": "Note", "type": "string" }
      ]
    }
  ],
  "sections": [
    {
      "type": "ReportHeader",
      "id": "report-header",
      "height": 40,
      "elements": [
        { "type": "field", "id": "title", "bounds": [0, 0, 400, 24], "style": "title", "value": "{param.ReportTitle}" },
        { "type": "text", "id": "subtitle", "bounds": [0, 26, 500, 14], "style": "label", "text": "Café · Grüße · Español · Ελληνικά · Русский · 日本語 · 中文 · العربية" }
      ]
    },
    {
      "type": "PageHeader",
      "id": "page-header",
      "height": 20,
      "elements": [
        { "type": "text", "id": "hdr-script", "cell": { "col": 0, "row": 0, "colSpan": 4, "rowSpan": 1 }, "style": "label", "text": "Script" },
        { "type": "text", "id": "hdr-greeting", "cell": { "col": 4, "row": 0, "colSpan": 10, "rowSpan": 1 }, "style": "label", "text": "Greeting" },
        { "type": "text", "id": "hdr-note", "cell": { "col": 14, "row": 0, "colSpan": 10, "rowSpan": 1 }, "style": "label", "text": "Note" }
      ]
    },
    {
      "type": "Detail",
      "id": "detail",
      "dataSet": "Rows",
      "height": 16,
      "elements": [
        { "type": "field", "id": "cell-script", "cell": { "col": 0, "row": 0, "colSpan": 4, "rowSpan": 1 }, "style": "cell", "value": "{Script}" },
        { "type": "field", "id": "cell-greeting", "cell": { "col": 4, "row": 0, "colSpan": 10, "rowSpan": 1 }, "style": "cell", "value": "{Greeting}" },
        { "type": "field", "id": "cell-note", "cell": { "col": 14, "row": 0, "colSpan": 10, "rowSpan": 1 }, "style": "cell", "value": "{Note}" }
      ]
    },
    {
      "type": "PageFooter",
      "id": "page-footer",
      "height": 24,
      "elements": [
        { "type": "field", "id": "page-no", "bounds": [0, 8, 200, 12], "style": "label", "value": "Page {page.number} of {page.count}" }
      ]
    }
  ]
}