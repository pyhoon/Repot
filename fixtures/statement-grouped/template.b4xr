{
  "schemaVersion": "0.1",
  "id": "statement.grouped",
  "name": "Grouped account statement",
  "description": "Multi-page statement grouped by month with subtotals and a grand total.",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins": { "top": "12mm", "right": "15mm", "bottom": "18mm", "left": "15mm" }
  },
  "fonts": {
    "body": { "family": ["DejaVu Sans", "Arial", "sans-serif"], "size": 9 }
  },
  "styles": {
    "title": { "font": "body", "size": 20, "bold": true },
    "heading": { "font": "body", "size": 10, "bold": true },
    "label": { "font": "body", "colour": "#555555" },
    "cell": { "font": "body", "valign": "middle", "overflow": "grow" },
    "cellRight": { "font": "body", "align": "right", "valign": "middle", "overflow": "grow" },
    "money": {
      "font": "body",
      "align": "right",
      "valign": "middle",
      "overflow": "grow",
      "format": { "type": "number", "decimals": 2, "grouping": true }
    },
    "total": { "font": "body", "size": 11, "bold": true, "align": "right" }
  },
  "parameters": [
    { "name": "AccountNumber", "type": "string", "required": true },
    { "name": "PeriodLabel", "type": "string", "required": false }
  ],
  "dataSets": [
    {
      "name": "Customer",
      "kind": "single",
      "fields": [
        { "name": "Name", "type": "string" },
        { "name": "Address", "type": "string" }
      ]
    },
    {
      "name": "Transactions",
      "kind": "rows",
      "fields": [
        { "name": "Month", "type": "string" },
        { "name": "Date", "type": "date" },
        { "name": "Description", "type": "string" },
        { "name": "Amount", "type": "decimal" }
      ],
      "aggregates": [
        { "name": "GrandTotal", "function": "sum", "field": "Amount" },
        { "name": "EntryCount", "function": "count" }
      ]
    }
  ],
  "groups": [
    {
      "id": "by-month",
      "dataSet": "Transactions",
      "key": "{Month}",
      "sort": [{ "field": "Date", "direction": "ascending" }],
      "repeatHeader": true,
      "aggregates": [
        { "name": "MonthTotal", "function": "sum", "field": "Amount" }
      ]
    }
  ],
  "sections": [
    {
      "type": "ReportHeader",
      "id": "report-header",
      "height": 80,
      "elements": [
        { "type": "field", "id": "cust-name", "bounds": [0, 0, 300, 14], "style": "heading", "value": "{Customer.Name}" },
        {
          "type": "field",
          "id": "cust-address",
          "bounds": [0, 18, 300, 14],
          "style": "cell",
          "value": "{Customer.Address}"
        },
        { "type": "text", "id": "title", "bounds": [340, 56, 170, 24], "style": "title", "text": "STATEMENT" },
        {
          "type": "field",
          "id": "period",
          "bounds": [340, 0, 170, 14],
          "style": "label",
          "align": "right",
          "value": "{param.PeriodLabel}"
        }
      ]
    },
    {
      "type": "PageHeader",
      "id": "page-header",
      "height": 20,
      "elements": [
        { "type": "text", "id": "col-date", "bounds": [0, 0, 60, 14], "style": "label", "text": "Date" },
        { "type": "text", "id": "col-desc", "bounds": [70, 0, 300, 14], "style": "label", "text": "Description" },
        { "type": "text", "id": "col-amount", "bounds": [380, 0, 130, 14], "style": "label", "text": "Amount", "align": "right" },
        { "type": "line", "id": "header-rule", "bounds": [0, 17, 510, 0], "colour": "#999999", "width": 0.5 }
      ]
    },
    {
      "type": "GroupHeader",
      "id": "group-header",
      "group": "by-month",
      "height": 18,
      "elements": [
        { "type": "field", "id": "month-name", "bounds": [0, 0, 200, 14], "style": "heading", "value": "{Month}" },
        { "type": "line", "id": "group-rule", "bounds": [0, 16, 510, 0], "colour": "#cccccc", "width": 0.5 }
      ]
    },
    {
      "type": "Detail",
      "id": "detail",
      "dataSet": "Transactions",
      "height": 14,
      "elements": [
        {
          "type": "field",
          "id": "entry-date",
          "bounds": [0, 0, 60, 14],
          "style": "cell",
          "value": "{Date}",
          "format": { "type": "date", "pattern": "dd" }
        },
        { "type": "field", "id": "entry-desc", "bounds": [70, 0, 300, 14], "style": "cell", "value": "{Description}" },
        { "type": "field", "id": "entry-amount", "bounds": [380, 0, 130, 14], "style": "money", "value": "{Amount}" }
      ]
    },
    {
      "type": "GroupFooter",
      "id": "group-footer",
      "group": "by-month",
      "height": 18,
      "elements": [
        { "type": "text", "id": "subtotal-label", "bounds": [300, 2, 80, 14], "style": "label", "text": "Subtotal", "align": "right" },
        { "type": "field", "id": "subtotal-value", "bounds": [380, 2, 130, 14], "style": "money", "value": "{MonthTotal}" }
      ]
    },
    {
      "type": "ReportFooter",
      "id": "report-footer",
      "height": 36,
      "keepTogether": true,
      "elements": [
        { "type": "text", "id": "grand-label", "bounds": [300, 8, 80, 16], "style": "total", "text": "Grand total" },
        { "type": "field", "id": "grand-value", "bounds": [380, 8, 130, 16], "style": "total", "value": "{GrandTotal}" }
      ]
    },
    {
      "type": "PageFooter",
      "id": "page-footer",
      "height": 24,
      "elements": [
        { "type": "field", "id": "page-no", "bounds": [0, 8, 120, 12], "style": "label", "value": "Page {page.number} of {page.count}" },
        { "type": "field", "id": "account", "bounds": [150, 8, 150, 12], "style": "label", "value": "Account {param.AccountNumber}" },
        { "type": "field", "id": "customer", "bounds": [310, 8, 200, 12], "style": "label", "align": "right", "value": "{Customer.Name}" }
      ]
    }
  ]
}
