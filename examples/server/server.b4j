AppType=StandardJava
Build1=Default,b4j.miniserver
Group=Default Group
Library1=jcore
Library2=jserver
Library3=repot
Library4=json
Module1=ReportHandler
NumberOfFiles=0
NumberOfLibraries=4
NumberOfModules=1
Version=10.7
@EndOfDesignText@
'Non-UI application (console application)
#Region  Project Attributes 
	#CommandLineArgs:
	#MergeLibraries: true 
#End Region

Sub Process_Globals
	Private srvr As Server
End Sub

' <link>Click to browse|http://127.0.0.1:8080/report/pdf</link>
Sub AppStart (Args() As String)
	srvr.Initialize("srvr")
	srvr.Port = 8080 ' default
	srvr.StaticFilesFolder = File.Combine(File.DirApp, "www")
	srvr.LogsFileFolder = File.Combine(File.DirApp, "logs")
	srvr.AddHandler("/report/pdf", "ReportHandler", False)
	srvr.Start
	Log("Server started")
	StartMessageLoop
End Sub