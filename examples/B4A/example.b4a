Build1=Default,b4a.example
Group=Default Group
Library1=core
Library2=repot
Library3=json
Library4=javaobject
ManifestCode='This code will be applied to the manifest file during compilation.~\n~'You do not need to modify it in most cases.~\n~'See this link for for more information: https://www.b4x.com/forum/showthread.php?p=78136~\n~AddManifestText(~\n~<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36"/>~\n~<supports-screens android:largeScreens="true" ~\n~    android:normalScreens="true" ~\n~    android:smallScreens="true" ~\n~    android:anyDensity="true"/>)~\n~SetApplicationAttribute(android:icon, "@drawable/icon")~\n~SetApplicationAttribute(android:label, "$LABEL$")~\n~CreateResourceFromFile(Macro, Themes.LightTheme)~\n~AddApplicationText(~\n~<provider android:name="android.support.v4.content.FileProvider" android:authorities="$PACKAGE$.provider" android:exported="false" android:grantUriPermissions="true">~\n~    <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/provider_paths" />~\n~</provider>)~\n~CreateResource(xml, provider_paths,~\n~<files-path name="name" path="shared" />)~\n~'End of default text.~\n~
NumberOfFiles=0
NumberOfLibraries=4
NumberOfModules=0
Version=14.2
@EndOfDesignText@
' Example: render the invoice-basic fixture on B4A and export HTML.
#Region  Project Attributes
	#ApplicationLabel: Repot Example
	#SupportedOrientations: portrait
	#CanInstallToExternalStorage: False
	#if AAB
	#R8Optimizer: True
	#End If
#End Region

#Region  Activity Attributes
	#FullScreen: False
	#IncludeTitle: True
#End Region

Sub Process_Globals
End Sub

Sub Globals
	Private lbl As Label
	Private btnPrint As Button
	Private btnSave As Button
	Private mReport As Repot
	Private mOutDir As String
End Sub

Sub Activity_Create(FirstTime As Boolean)
	lbl.Initialize("")
	lbl.TextSize = 14
	Activity.AddView(lbl, 10dip, 10dip, 100%x - 20dip, 100%y - 130dip)
	btnSave.Initialize("btnSave")
	btnSave.Text = "Save As PDF"
	Activity.AddView(btnSave, 10dip, 100%y - 110dip, 100%x - 20dip, 50dip)
	btnPrint.Initialize("btnPrint")
	btnPrint.Text = "Print PDF"
	Activity.AddView(btnPrint, 10dip, 100%y - 60dip, 100%x - 20dip, 50dip)
	RunExample
End Sub

Sub Activity_Result (RequestCode As Int, ResultCode As Int, Data As Object)
	'SAF CreateDocument result: pick the chosen location and copy the PDF.
	Dim uri As String = ReportSaveAs.HandleActivityResult(RequestCode, ResultCode, Data)
	If uri <> "" Then
		If ReportSaveAs.CopyFileToUri(mOutDir, "invoice.pdf", uri) Then
			Log("SaveAs: PDF saved to " & uri)
			lbl.Text = "PDF saved to user-chosen location"
		Else
			Log("SaveAs: failed to save PDF to " & uri)
		End If
	End If
End Sub

Sub btnPrint_Click
	If mReport = Null Then Return
	Log("print: " & mReport.PrintPdf(mOutDir, "invoice.pdf", "Repot invoice"))
End Sub

Sub btnSave_Click
	If mReport = Null Then Return
	Dim i As Intent = mReport.SaveAsPdfIntent("application/pdf", "invoice.pdf")
	If i <> Null Then
		ReportSaveAs.StartForResult(i, ReportSaveAs.DefaultRequestCode)
		Log("SaveAs: SAF picker opened")
	End If
End Sub

Sub RunExample
	Dim fixDir As String = File.DirInternal & "/fixtures/invoice-basic"
	CopyAssets
	Dim outDir As String = File.DirInternal
	mOutDir = outDir

	mReport.Initialize
	If mReport.LoadTemplate(fixDir, "template.repot") = False Then
		Log("Load errors")
		lbl.Text = "Load failed"
		Return
	End If

	Dim params As Map = LoadJsonMap(fixDir, "params.json")
	For Each k As String In params.Keys
		mReport.SetParameter(k, params.Get(k))
	Next
	Dim data As Map = LoadJsonMap(fixDir, "data.json")
	For Each name As String In data.Keys
		Dim o As Object = data.Get(name)
		If o Is List Then
			mReport.SetDataSource(name, o)
		Else If o Is Map Then
			mReport.SetDataSourceSingle(name, o)
		End If
	Next

	Dim res As ReportResult = mReport.Build
	If res.Success = False Then
		lbl.Text = "Build failed"
		Return
	End If
	Log("Rendered " & res.PageCount & " page(s), " & res.RecordCount & " record(s)")

	Dim htmlPath As String = File.Combine(outDir, "invoice.html")
	If mReport.ExportHtml(htmlPath) = False Then
		lbl.Text = "HTML export failed"
		Return
	End If
	Log("HTML -> " & htmlPath)

	Dim vPath As String = File.Combine(outDir, "invoice.pdf")
	If mReport.ExportPdf(vPath) Then
		Log("PDF -> " & vPath)
		lbl.Text = "HTML + PDF exported:" & CRLF & vPath
		ReportB4AOpen.OpenPdf(outDir, "invoice.pdf")
	Else
		lbl.Text = "PDF export failed"
	End If
End Sub

Private Sub CopyAssets
	Dim dst As String = File.DirInternal & "/fixtures/invoice-basic"
	File.MakeDir(File.DirInternal, "fixtures")
	File.MakeDir(File.DirInternal & "/fixtures", "invoice-basic")
	For Each n As String In Array As String("template.repot","data.json","params.json","logo.png")
		File.Copy(File.DirAssets, "fixtures/invoice-basic/" & n, dst, n)
	Next
End Sub

Private Sub LoadJsonMap(dir As String, name As String) As Map
	Dim parser As JSONParser
	parser.Initialize(File.ReadString(dir, name))
	Return parser.NextObject
End Sub
