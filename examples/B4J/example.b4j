AppType=StandardJava
Build1=Default,b4j.example
Group=Default Group
Library1=jcore
Library2=json
Library3=javaobject
Library4=repot
NumberOfFiles=0
NumberOfLibraries=4
NumberOfModules=0
Version=10.7
@EndOfDesignText@
' Example: render the invoice-basic fixture and export HTML + PDF.
' Run: java -jar Objects\example.jar [fixtureFolder] [outputFolder]
Sub Process_Globals

End Sub

Sub AppStart (Args() As String)
    Dim fixtureDir As String = ""
    Dim candidates() As String = Array As String( _
        "..\..\..\fixtures\invoice-basic", _
        "..\..\..\..\fixtures\invoice-basic", _
        "..\..\fixtures\invoice-basic", _
        "fixtures\invoice-basic")
    For Each c As String In candidates
        If File.Exists(c, "template.repot") Then
            fixtureDir = c
            Exit
        End If
    Next
    If fixtureDir = "" Then fixtureDir = "..\..\..\fixtures\invoice-basic"
    Dim outDir As String = "."
    If Args.Length > 0 Then fixtureDir = Args(0)
    If Args.Length > 1 Then outDir = Args(1)

    Dim loader As ReportTemplateLoader
    loader.Initialize
    Dim def As ReportDefinition = loader.LoadFromFile(fixtureDir, "template.repot")
    If loader.Diagnostics.HasErrors Then
        Log("Load errors:")
        For Each d As ReportDiagnostic In loader.Diagnostics.Items
            Log("  " & d.Code & " " & d.Message)
        Next
        Return
    End If

    Dim binder As ReportDataBinder
    binder.Initialize(def)
    Dim params As Map = LoadJsonMap(fixtureDir, "params.json")
    For Each k As String In params.Keys
        binder.SetParameter(k, params.Get(k))
    Next
    Dim data As Map = LoadJsonMap(fixtureDir, "data.json")
    For Each name As String In data.Keys
        Dim o As Object = data.Get(name)
        If o Is List Then
            binder.SetDataSource(name, o)
        Else If o Is Map Then
            binder.SetDataSourceSingle(name, o)
        End If
    Next
    If binder.Validate = False Then
        Log("Binding validation failed")
        Return
    End If

    Dim diags As ReportDiagnostics
    diags.Initialize
    Dim measure As ReportB4JMeasure
    measure.Initialize(diags)
    Dim pag As ReportPaginator
    pag.Initialize(def, binder, measure, diags)
    Dim doc As ReportRenderDocument = pag.Render
    Log("Rendered " & doc.Pages.Size & " page(s)")

    File.MakeDir(outDir, "")
    Dim htmlPath As String = File.Combine(outDir, "invoice.html")
    Dim html As ReportHtmlExporter
    html.Initialize(diags)
    If html.Export(doc, htmlPath) Then Log("HTML -> " & htmlPath) Else Log("HTML export failed")

    Dim pdfPath As String = File.Combine(outDir, "invoice.pdf")
    Dim pdf As ReportPdfExporter
    pdf.Initialize(diags)
    If pdf.Export(doc, pdfPath) Then
        Log("PDF  -> " & pdfPath)
        ReportB4JOpen.OpenPdf(outDir, "invoice.pdf")
    Else
        Log("PDF export failed (B4J only)")
    End If

    For Each d As ReportDiagnostic In diags.Items
        Log("diag: " & d.Code & " " & d.Message)
    Next
End Sub

Private Sub LoadJsonMap(dir As String, name As String) As Map
    Dim parser As JSONParser
    parser.Initialize(File.ReadString(dir, name))
    Return parser.NextObject
End Sub

